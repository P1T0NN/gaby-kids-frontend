# Better Auth application origin. Use the exact frontend origin for each
# deployment, for example http://localhost:5173 in development.
PUBLIC_ORIGIN="http://localhost:5173"

# Better Auth secret. Use a unique 32+ character secret per deployment.
BETTER_AUTH_SECRET='replace-with-a-unique-32-plus-character-secret'

# Google OAuth credentials required when socialProviders.google is enabled in
# src/convex/auth/auth.ts.
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"

# Resend credentials used by Better Auth Email OTP delivery.
RESEND_API_KEY="replace-with-resend-api-key"
EMAIL_FROM="onboarding@resend.dev"

# Cloudflare Turnstile. The site key is also needed by SvelteKit; keep the
# secret key only in the Convex deployment environment.
# PUBLIC_TURNSTILE_SITE_KEY="replace-with-cloudflare-turnstile-site-key"
TURNSTILE_SECRET_KEY="replace-with-cloudflare-turnstile-secret-key"

# Cloudflare R2 credentials used by @convex-dev/r2.
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="replace-with-r2-access-key-id"
STORAGE_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"
STORAGE_BUCKET_NAME="replace-with-r2-bucket-name"
# Optional permanent public base URL, preferably an R2 custom domain.
# Without it, API responses use one-hour signed R2 URLs.
STORAGE_PUBLIC_URL="https://<public-bucket-domain>"
